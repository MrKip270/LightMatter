{
  "name": "lightmatter",
  "version": "0.1.0",
  "description": "Estimate what's viewable in the sky from any location.",
  "keywords": [
    "astronomy",
    "weather",
    "stargazing"
  ],
  "repository": {
    "type": "git",
    "url": "git@github-personal:MrKip270/LightMatter.git"
  },
  "license": "ISC",
  "author": "Kaleb Bryant",
  "type": "commonjs",
  "main": "backend/server.js",
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node backend/server.js",
    "test": "node --test --test-reporter=./tests/reporters/grouped.js --test-reporter-destination=stdout \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "pngjs": "^7.0.0",
    "suncalc": "^2.0.1"
  },
  "devDependencies": {
    "geotiff": "^3.0.5"
  }
}
