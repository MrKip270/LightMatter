# --- Node ---
# Downloaded dependencies. These are huge and can always be reinstalled
# from package.json, so we never commit them.
node_modules/

# --- Secrets ---
# Environment files hold API keys and passwords. NEVER commit these.
.env
.env.local
*.local

# --- Logs ---
*.log
npm-debug.log*

# --- Large source datasets ---
# The raw World Atlas GeoTIFF is 2.9 GB (653 MB zipped). It is an INPUT to
# tools/build-lightpollution.js, not part of the app. Keep it outside the repo;
# only the small downsampled grid the tool produces gets committed.
*.tif
*.tiff
World_Atlas*.zip
data/raw/

# --- OS / editor junk ---
.DS_Store
Thumbs.db
.vscode/

# --- Impeccable design tooling ---
# The hook cache is a per-session runtime artifact; critique snapshots are kept.
.impeccable/hook.cache.json
